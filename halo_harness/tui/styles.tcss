/* halo_harness.tui styles -- colors come from BridgeApp.get_css_variables()
   (tui/theme.py's `variables_for`), never hardcoded here, so a theme swap
   only ever needs a new palette dict, not a stylesheet edit. */

Screen {
    background: $bridge-bg;
    color: $bridge-text;
    layout: vertical;
}

#transcript {
    height: 1fr;
    width: 100%;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#transcript > * {
    margin: 0 0 1 0;
    width: 100%;
}

.user-message {
    color: $bridge-user;
    text-style: bold;
}

.system-note {
    color: $bridge-muted;
}

/* 2.0.0 Launch intro: "a dim first entry of the session" once it finishes
   typing -- same muted tone as a system note, never competing with real
   transcript content. */
.intro-line {
    color: $bridge-muted;
}

.system-note-error {
    color: $bridge-error;
    text-style: bold;
}

.system-note-command, .system-note-note, .system-note-replay {
    color: $bridge-muted;
}

.system-note-subagent {
    color: $bridge-accent;
}

/* 2.0.7 round 0b: background job / sub-agent completion notices --
   automated status, not the owner's words, so they read as machine
   output: accent color like the subagent markers but italic, keeping
   them visually distinct from both user bubbles and plain notes. */
.system-note-status {
    color: $bridge-accent;
    text-style: italic;
}

.folded-history {
    color: $bridge-muted;
    text-style: italic;
    border: round $bridge-border;
    padding: 0 1;
}

.thinking-block {
    color: $bridge-thinking;
    text-style: italic;
    padding: 0 2;
}

AssistantText {
    color: $bridge-assistant;
}

/* 2.0.6 release-gate (rolo's live report, 2026-10-07 evening): code
   blocks in the transcript turned into BLACK BOXES that vanished when
   the mouse passed over them. Root cause: Textual's MarkdownFence is
   itself a scrollable container (overflow: scroll hidden) -- on mouse
   entry Textual repaints the region as a scroll target, and that
   repaint races the ongoing stream updates, leaving the fence's
   background painted over lines whose content hasn't re-rendered yet.
   Local models surfaced it constantly (qwen wraps most answers in
   fences). A fence inside a TRANSCRIPT never needs to scroll (the
   transcript itself scrolls): pinned to a plain non-scrolling block,
   the hover repaint path disappears entirely. */
AssistantText MarkdownFence {
    overflow: hidden;
    scrollbar-size-horizontal: 0;
    scrollbar-size-vertical: 0;
    height: auto;
}

/* H9 whole-tree review finding 11: a sub-agent's own streamed text/
   thinking blocks get a left border + the SAME accent color
   .system-note-subagent already uses for its start/end markers, so a
   child's output reads as its own grouped block within the transcript
   flow rather than blending into the main session's own text. */
.assistant-text-child {
    border-left: thick $bridge-accent;
    padding: 0 1;
}

.thinking-block-child {
    border-left: thick $bridge-accent;
}

.tool-card {
    color: $bridge-tool;
    border-left: thick $bridge-border;
    padding: 0 1;
}

.tool-card.tool-running {
    border-left: thick $bridge-warning;
}

.tool-card.tool-ok {
    border-left: thick $bridge-success;
}

.tool-card.tool-error {
    border-left: thick $bridge-error;
    color: $bridge-error;
}

.diff-view {
    border: round $bridge-border;
    padding: 0 1;
    margin-left: 2;
}

.permission-card, .question-card, .plan-card, .rewind-card, .approval-card {
    border: round $bridge-warning;
    background: $bridge-surface;
    padding: 1 2;
}

#which-key-overlay {
    max-height: 10;
    border: round $bridge-accent;
    background: $bridge-panel;
    color: $bridge-text;
    padding: 0 1;
}

.question-heading {
    text-style: bold;
    margin-top: 1;
}

#completion-popup {
    max-height: 8;
    border: round $bridge-border;
    background: $bridge-panel;
}

#bottom-dock {
    dock: bottom;
    height: auto;
    width: 100%;
}

#prompt-row {
    height: auto;
    max-height: 10;
    background: $bridge-surface;
    border-top: solid $bridge-border;
}

#prompt-glyph {
    width: 2;
    color: $bridge-accent;
    text-style: bold;
    content-align: center middle;
}

#prompt-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    background: $bridge-surface;
    border: none;
}

.status-bar {
    height: 1;
    width: 100%;
    background: $bridge-panel;
    color: $bridge-text;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

/* Halo 2.0.8 theme pack: a skin that declares `heavy_borders` (tui/hud.py)
   puts the `hud-heavy` class on the app; panels, cards and dialogs then
   trade their round borders for heavy ones. The colours still come from the
   theme's palette variables. */
.hud-heavy .permission-card, .hud-heavy .question-card, .hud-heavy .plan-card,
.hud-heavy .rewind-card, .hud-heavy .approval-card {
    border: heavy $bridge-warning;
}

.hud-heavy .folded-history, .hud-heavy .diff-view {
    border: heavy $bridge-border;
}

.hud-heavy #which-key-overlay {
    border: heavy $bridge-accent;
}

.hud-heavy #completion-popup {
    border: heavy $bridge-border;
}

.hud-heavy #prompt-row {
    border-top: heavy $bridge-border;
}

.hud-heavy ModalScreen > Vertical, .hud-heavy ModalScreen > VerticalScroll,
.hud-heavy ModalScreen > Horizontal, .hud-heavy PagerScreen > Static,
.hud-heavy QuitConfirmScreen > Static {
    border: heavy $bridge-accent;
}
