{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halo-harness:schema:pack:1",
  "title": "Halo pack manifest (pack.yaml), extension API 1.x",
  "description": "The manifest at a pack's root. Read with halo_harness.packs.manifest; the extension API it targets is halo_api (1.0 in Halo 3.2.0.0). docs/EXTENSION_API.md is the reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "halo_api"],
  "$defs": {
    "version": {"type": ["string", "number"], "pattern": "^\\d+(\\.\\d+){0,3}([-+].*)?$"},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"min": {"$ref": "#/$defs/version"}, "max": {"$ref": "#/$defs/version"}}
    },
    "names": {"type": "array", "items": {"type": "string"}},
    "link": {"type": "object", "additionalProperties": false,
             "properties": {"label": {"type": "string"}, "route": {"type": "string"}, "url": {"type": "string"}}},
    "panel": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
      "description": "A Studio panel a pack declares (3.2.0.0 R3); Studio's own components render it.",
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*$"},
        "title": {"type": "string"},
        "kind": {"enum": ["markdown", "table", "form", "links", "events", "bundle", "artifact"]},
        "source": {"type": "string", "description": "a file under the pack (markdown, table, bundle, artifact) or data:<path> in its data folder (table, artifact); latest (artifact: the newest run's)"},
        "schema": {"type": "string", "description": "an artifact panel's schema: one of contributes.artifacts (3.2.0.0 R5)"},
        "w": {"type": "integer", "minimum": 4, "maximum": 24},
        "h": {"type": "integer", "minimum": 8, "maximum": 200},
        "help": {"type": "string"},
        "columns": {"$ref": "#/$defs/names"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "description": "A worker capability the pack brings (3.2.0.0 R4): its name is one of the top-level capabilities; requires says what this host needs for it to be available.",
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "description": {"type": "string", "description": "a sentence; no path, no secret, no environment reference"},
        "requires": {"type": "object", "additionalProperties": false, "properties": {
          "tools": {"$ref": "#/$defs/names", "description": "CLIs on PATH, MCP servers or craft apps"},
          "runtimes": {"$ref": "#/$defs/names", "description": "python, node, java ..."},
          "platform": {"$ref": "#/$defs/names", "description": "linux, windows, darwin or a distro"},
          "hardware": {"type": "object", "additionalProperties": false,
                       "properties": {"gpu": {"type": ["boolean", "string"]}, "ram_gb": {"type": "number", "minimum": 0}}},
          "models": {"$ref": "#/$defs/names", "description": "a model ref or a capability tag (long-context, vision, tools ...)"},
          "grants": {"$ref": "#/$defs/names", "description": "permissions of the pack this capability needs granted"},
          "locality": {"type": "array", "items": {"type": "string", "pattern": "^(repo|repo:.+|shared|pack-data)$"}}}},
        "capacity": {"type": "object", "additionalProperties": false,
                     "properties": {"parallel": {"type": "integer", "minimum": 1}}}
      }
    },
    "fleet": {
      "type": "object", "additionalProperties": false,
      "description": "What the pack brings to the fleet (3.2.0.0 R4): worker capabilities in the capabilities catalog, mission inspector lines, mission metadata.",
      "properties": {
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "inspector": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "source"],
          "properties": {"label": {"type": "string"}, "source": {"type": "string", "description": "a markdown or JSON file under the pack"}}}},
        "mission": {"type": "object", "additionalProperties": false,
                    "properties": {"metadata": {"type": "object", "description": "what a mission started by this pack's lineup carries"}}}
      }
    },
    "studio": {
      "type": "object", "additionalProperties": false,
      "description": "What the pack adds to Studio (3.2.0.0 R3): its own sections after Orchestra, panels in a core section, palette actions, a config form, its event lines and attention rows.",
      "properties": {
        "sections": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "title"],
          "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "blurb": {"type": "string"},
                         "help": {"type": "string"}, "panels": {"type": "array", "items": {"$ref": "#/$defs/panel"}}}}},
        "panels": {"type": "array", "items": {"allOf": [
          {"properties": {"section": {"enum": ["session", "team", "roles", "fleet", "design", "orchestra"]}}, "required": ["section"]},
          {"$ref": "#/$defs/panel"}]}},
        "palette": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label", "action"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"},
                         "action": {"type": "string", "pattern": "^(route:.+|url:.+|config)$"}}}},
        "config_form": {"type": "boolean"},
        "events": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "properties": {"label": {"type": "string"}, "line": {"type": "string"}}}},
        "attention": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "properties": {"label": {"type": "string"},
                         "keys": {"type": "object", "additionalProperties": false,
                                  "properties": {"a": {"type": "string"}, "r": {"type": "string"},
                                                 "s": {"type": "string"}, "o": {"type": "string"}}}}}}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64,
           "description": "The pack's id and namespace: its folder name, the prefix of its bios and lineups (<id>--<name>), skills and commands (<id>:<name>) and MCP servers (plugin_<id>_<server>). No '--', no trailing '-'."},
    "name": {"type": "string", "description": "The name a person reads."},
    "version": {"type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
                "description": "The pack's own version, semver."},
    "description": {"type": "string"},
    "author": {"oneOf": [{"type": "string"},
                         {"type": "object", "additionalProperties": false,
                          "properties": {"name": {"type": "string"}, "email": {"type": "string"}, "url": {"type": "string"}}}]},
    "license": {"type": "string", "description": "An SPDX id such as MIT."},
    "halo_api": {"allOf": [{"$ref": "#/$defs/range"}, {"required": ["min"]}],
                 "description": "The extension API versions the pack works with (halo_harness.ext.API_VERSION)."},
    "halo": {"$ref": "#/$defs/range", "description": "The Halo versions the pack works with (halo --version)."},
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}},
    "requires": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["pack"],
      "properties": {"pack": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                     "version": {"oneOf": [{"$ref": "#/$defs/version"}, {"$ref": "#/$defs/range"}]}}}},
    "contributes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "agents": {"type": "array", "items": {"type": "string", "pattern": "^agents/[A-Za-z0-9][A-Za-z0-9_-]*\\.(yaml|md)$"}},
        "teams": {"type": "array", "items": {"type": "string", "pattern": "^teams/[A-Za-z0-9][A-Za-z0-9_-]*\\.yaml$"}},
        "skills": {"const": "skills"},
        "commands": {"const": "commands"},
        "hooks": {"const": "hooks/hooks.json"},
        "mcp": {"type": "array", "items": {"type": "object", "required": ["name"],
                                           "properties": {"name": {"type": "string"}, "description": {"type": "string"}}}},
        "studio": {"$ref": "#/$defs/studio"},
        "fleet": {"$ref": "#/$defs/fleet"},
        "artifacts": {"type": "array", "items": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]*|artifacts/[A-Za-z0-9][A-Za-z0-9_-]*\\.json)$"}, "description": "artifact schemas: artifacts/<name>.json (3.2.0.0 R5)"},
        "events": {"type": "array", "items": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "schema": {"type": "string"}, "description": {"type": "string"}}}]}, "description": "a kind (its schema: events/<kind>.json when the pack ships it) or {kind, schema} (3.2.0.0 R5)"},
        "workflows": {"type": "array", "items": {"type": "string"}, "description": "workflow names (3.2.0.0 R2), each workflows/<name>.yaml when the pack ships it (workflow.schema.json, 3.2.0.0 R5)"}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "properties": {"schema": {"type": "object", "description": "A halo_harness.schemas.check schema for packs.settings.<id>."},
                     "defaults": {"type": "object"}}
    },
    "permissions": {"type": "array", "items": {"type": "string", "pattern": "^(mcp:.+|hooks|bash|network|home-write|studio-script)$"}},
    "migrations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "note"],
      "properties": {"from": {"$ref": "#/$defs/version"}, "to": {"$ref": "#/$defs/version"}, "note": {"type": "string"}}}}
  }
}
