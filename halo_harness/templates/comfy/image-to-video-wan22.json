{
 "1": {"class_type": "LoadImage", "_meta": {"title": "Start image", "keys": {"image": "image"}},
       "inputs": {"image": "example.png"}},
 "2": {"class_type": "CLIPLoader", "_meta": {"title": "Wan text encoder"},
       "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
 "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt", "keys": {"prompt": "text"}},
       "inputs": {"text": "the subject comes to life with natural, subtle movement, hair and clothes stir in a light breeze, slow camera push-in",
                  "clip": ["2", 0]}},
 "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative", "keys": {"negative": "text"}},
       "inputs": {"text": "static, frozen frame, blurry details, subtitles, watermark, overexposed, worst quality, low quality, jpeg artifacts, deformed hands, deformed face, extra fingers, cluttered background",
                  "clip": ["2", 0]}},
 "5": {"class_type": "VAELoader", "_meta": {"title": "Wan VAE"},
       "inputs": {"vae_name": "wan_2.1_vae.safetensors"}},
 "6": {"class_type": "WanImageToVideo", "_meta": {"title": "Image to video", "keys": {"width": "width", "height": "height", "length": "length"}},
       "inputs": {"width": 832, "height": 480, "length": 81, "batch_size": 1,
                  "positive": ["3", 0], "negative": ["4", 0], "vae": ["5", 0], "start_image": ["1", 0]}},
 "7": {"class_type": "UNETLoader", "_meta": {"title": "Wan 2.2 i2v high noise"},
       "inputs": {"unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}},
 "8": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "lightx2v 4-step LoRA (high)"},
       "inputs": {"lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors", "strength_model": 1.0, "model": ["7", 0]}},
 "10": {"class_type": "UNETLoader", "_meta": {"title": "Wan 2.2 i2v low noise"},
        "inputs": {"unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default"}},
 "11": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "lightx2v 4-step LoRA (low)"},
        "inputs": {"lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors", "strength_model": 1.0, "model": ["10", 0]}},
 "13": {"class_type": "KSamplerAdvanced", "_meta": {"title": "Sampler (high noise)", "keys": {"seed": "noise_seed", "steps": "steps"}},
        "inputs": {"add_noise": "enable", "noise_seed": 20261014, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple",
                   "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable",
                   "model": ["8", 0], "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["6", 2]}},
 "14": {"class_type": "KSamplerAdvanced", "_meta": {"title": "Sampler (low noise)", "keys": {"steps": "steps"}},
        "inputs": {"add_noise": "disable", "noise_seed": 0, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple",
                   "start_at_step": 2, "end_at_step": 10000, "return_with_leftover_noise": "disable",
                   "model": ["11", 0], "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["13", 0]}},
 "15": {"class_type": "VAEDecode", "_meta": {"title": "Decode"},
        "inputs": {"samples": ["14", 0], "vae": ["5", 0]}},
 "16": {"class_type": "CreateVideo", "_meta": {"title": "Frames to video"},
        "inputs": {"images": ["15", 0], "fps": 16.0}},
 "17": {"class_type": "SaveVideo", "_meta": {"title": "Save"},
        "inputs": {"video": ["16", 0], "filename_prefix": "halo/image-to-video", "format": "auto", "format.codec": "auto"}}
}
